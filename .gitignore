# Sensitive / user-specific config (contains API key)
config.json

# Game save state
state.json

# Background images (generated / replaced by user)
rules/**/backgrounds/*.jpg
rules/**/backgrounds/*.png

# Session exports (user game history)
rules/**/sessions/*.json
!rules/**/sessions/chronicle.json

# Terminal profile cache (user-specific WT GUID / path)
rules/settings.json

# Runtime task queue
rules/_shared/_pending_tasks.json

# Session runtime state
_session_start.json
_session_enrich.json
_archive.json
state.json.bak

# Background metadata (generated at runtime)
rules/**/backgrounds.json
rules/**/backgrounds/*.meta.json

# Python
__pycache__/
*.pyc
*.pyo

# Claude Code
.claude/*
!.claude/settings.local.json
!.claude/skills/
